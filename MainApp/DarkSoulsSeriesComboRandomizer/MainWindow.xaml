<Window x:Class="DarkSoulsSeriesComboRandomizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dark Souls Series Combo Randomizer"
        Height="600" Width="700"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1A"
        Foreground="#D4B483">

    <Window.Resources>
        <!-- Dark Souls themed colors -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#242424"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#5A4A2A"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#D4B483"/>
        <SolidColorBrush x:Key="AccentDimBrush" Color="#8A7050"/>
        <SolidColorBrush x:Key="TextBrush" Color="#D4B483"/>
        <SolidColorBrush x:Key="SubtextBrush" Color="#8A7050"/>
        <SolidColorBrush x:Key="DisabledBrush" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="DisabledTextBrush" Color="#555555"/>
        <SolidColorBrush x:Key="RedAccentBrush" Color="#C0392B"/>
        <SolidColorBrush x:Key="RedAccentDimBrush" Color="#7A2519"/>

        <!-- TextBox Style -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2E2E2E"/>
            <Setter Property="Foreground" Value="#D4B483"/>
            <Setter Property="CaretBrush" Value="#D4B483"/>
            <Setter Property="BorderBrush" Value="#5A4A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#252525"/>
                    <Setter Property="Foreground" Value="#555555"/>
                    <Setter Property="BorderBrush" Value="#333333"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#8A7050"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#D4B483"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#2E2E2E"/>
            <Setter Property="Foreground" Value="#D4B483"/>
            <Setter Property="BorderBrush" Value="#5A4A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Grid.Column="2" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" >
                                <ToggleButton.Template>
                                    <ControlTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="7*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="Border"  Grid.ColumnSpan="2" CornerRadius="5" Background="#5A4A2A" BorderBrush="Black" BorderThickness="1" />
                                            <Border Grid.Column="0" CornerRadius="5,0,0,5"  Margin="1"  Background="#2E2E2E"  BorderBrush="Black" BorderThickness="0,0,1,0" />
                                            <Path x:Name="Arrow" Grid.Column="1"  Fill="#2E2E2E" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="ToggleButton.IsMouseOver" Value="true">
                                                <Setter TargetName="Border" Property="Background" Value="#D4B483" />
                                            </Trigger>
                                            <Trigger Property="ToggleButton.IsChecked" Value="true">
                                                <Setter TargetName="Border" Property="Background" Value="#8A7050" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"  Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="7"  />
                            <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"  Focusable="False" PopupAnimation="Slide">
                                <Grid  Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#2E2E2E" />
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#252525"/>
                    <Setter Property="Foreground" Value="#555555"/>
                    <Setter Property="BorderBrush" Value="#333333"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#8A7050"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Browse Button Style -->
        <Style x:Key="BrowseButton" TargetType="Button">
            <Setter Property="Background" Value="#2E2E2E"/>
            <Setter Property="Foreground" Value="#D4B483"/>
            <Setter Property="BorderBrush" Value="#5A4A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                                <Setter Property="BorderBrush" Value="#D4B483"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1A1A1A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#252525"/>
                                <Setter Property="Foreground" Value="#555555"/>
                                <Setter Property="BorderBrush" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button Style -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#3A2E14"/>
            <Setter Property="Foreground" Value="#D4B483"/>
            <Setter Property="BorderBrush" Value="#D4B483"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24,8"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5A4A20"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2A1E08"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#252525"/>
                                <Setter Property="Foreground" Value="#555555"/>
                                <Setter Property="BorderBrush" Value="#444444"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stop Button Style -->
        <Style x:Key="StopButton" TargetType="Button">
            <Setter Property="Background" Value="#3A1414"/>
            <Setter Property="Foreground" Value="#E8A0A0"/>
            <Setter Property="BorderBrush" Value="#C0392B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24,8"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5A2020"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#200808"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#252525"/>
                                <Setter Property="Foreground" Value="#555555"/>
                                <Setter Property="BorderBrush" Value="#444444"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label Style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A7050"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D4B483"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Separator Style -->
        <Style x:Key="DarkSeparator" TargetType="Separator">
            <Setter Property="Background" Value="#3A2E14"/>
            <Setter Property="Margin" Value="0,8,0,12"/>
        </Style>

        <!-- Read-only display TextBox -->
        <Style x:Key="DisplayTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#D4B483"/>
            <Setter Property="BorderBrush" Value="#3A2E14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Setup Panel -->
        <ScrollViewer x:Name="SetupPanel"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0"
                      Visibility="Visible">
            <StackPanel Margin="28,22,28,22">

                <!-- Title -->
                <TextBlock Text="DARK SOULS SERIES COMBO RANDOMIZER"
                           FontFamily="Segoe UI Black"
                           FontSize="15"
                           Foreground="#D4B483"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>
                <Rectangle Height="1" Fill="#5A4A2A" Margin="0,0,0,20"/>

                <!-- Game Paths Section -->
                <TextBlock Text="GAME LOCATIONS" Style="{StaticResource SectionHeader}"/>

                <!-- DS1 -->
                <TextBlock Text="Dark Souls Remastered" Style="{StaticResource FieldLabel}"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DS1PathBox"
                             Grid.Column="0"
                             Style="{StaticResource DarkTextBox}"
                             Height="30"
                             Margin="0,0,6,0"
                             Text="C:\Program Files (x86)\Steam\steamapps\common\DARK SOULS REMASTERED\DarkSoulsRemastered.exe"
                             TextChanged="GamePath_TextChanged"/>
                    <Button Grid.Column="1"
                            Style="{StaticResource BrowseButton}"
                            Height="30"
                            Content="Browse…"
                            Click="BrowseDS1_Click"/>
                </Grid>

                <!-- DS2 -->
                <TextBlock Text="Dark Souls II: Scholar of the First Sin" Style="{StaticResource FieldLabel}"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DS2PathBox"
                             Grid.Column="0"
                             Style="{StaticResource DarkTextBox}"
                             Height="30"
                             Margin="0,0,6,0"
                             Text="C:\Program Files (x86)\Steam\steamapps\common\Dark Souls II Scholar of the First Sin\Game\DarkSoulsII.exe"
                             TextChanged="GamePath_TextChanged"/>
                    <Button Grid.Column="1"
                            Style="{StaticResource BrowseButton}"
                            Height="30"
                            Content="Browse…"
                            Click="BrowseDS2_Click"/>
                </Grid>

                <!-- DS3 -->
                <TextBlock Text="Dark Souls III" Style="{StaticResource FieldLabel}"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DS3PathBox"
                             Grid.Column="0"
                             Style="{StaticResource DarkTextBox}"
                             Height="30"
                             Margin="0,0,6,0"
                             Text="C:\Program Files (x86)\Steam\steamapps\common\DARK SOULS III\Game\DarkSoulsIII.exe"
                             TextChanged="GamePath_TextChanged"/>
                    <Button Grid.Column="1"
                            Style="{StaticResource BrowseButton}"
                            Height="30"
                            Content="Browse…"
                            Click="BrowseDS3_Click"/>
                </Grid>

                <Rectangle Height="1" Fill="#3A2E14" Margin="0,0,0,18"/>

                <!-- Randomization Options Section -->
                <TextBlock Text="RANDOMIZATION OPTIONS" Style="{StaticResource SectionHeader}"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Seed -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Seed" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="SeedBox"
                                 Style="{StaticResource DarkTextBox}"
                                 Height="30"
                                 TextChanged="Seed_TextChanged"/>
                    </StackPanel>

                    <!-- Save Name -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Save Name" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="SaveNameBox"
                                 Style="{StaticResource DarkTextBox}"
                                 Height="30"/>
                    </StackPanel>
                </Grid>

                <!-- Load Previous Save -->
                <TextBlock Text="Load Previous Save" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="LoadSaveCombo"
                          Style="{StaticResource DarkComboBox}"
                          Height="30"
                          Margin="0,0,0,20"
                          SelectionChanged="LoadSave_SelectionChanged">
                    <ComboBoxItem Content="— New Run —" IsSelected="True"/>
                </ComboBox>

                <Rectangle Height="1" Fill="#3A2E14" Margin="0,0,0,16"/>

                <!-- Status / Error -->
                <TextBlock x:Name="StatusText"
                           Text=""
                           Foreground="#8A7050"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"
                           TextWrapping="Wrap"/>

                <!-- Play Button -->
                <Button x:Name="PlayButton"
                        Style="{StaticResource ActionButton}"
                        Content="▶  BEGIN JOURNEY"
                        HorizontalAlignment="Center"
                        MinWidth="180"
                        IsEnabled="False"
                        Click="Play_Click"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Running Panel -->
        <Grid x:Name="RunningPanel"
              Visibility="Collapsed"
              Background="#1A1A1A">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MinWidth="340">

                <!-- Title -->
                <TextBlock Text="DARK SOULS SERIES COMBO RANDOMIZER"
                           FontFamily="Segoe UI Black"
                           FontSize="15"
                           Foreground="#D4B483"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>
                <Rectangle Height="1" Fill="#5A4A2A" Margin="0,0,0,32"/>

                <TextBlock Text="SESSION ACTIVE"
                           FontFamily="Segoe UI Semibold"
                           FontSize="11"
                           Foreground="#8A7050"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28"/>

                <!-- Seed display -->
                <TextBlock Text="SEED" Style="{StaticResource FieldLabel}"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBox x:Name="RunSeedDisplay"
                         Style="{StaticResource DisplayTextBox}"
                         HorizontalAlignment="Center"
                         MinWidth="260"
                         Margin="0,0,0,20"
                         TextAlignment="Center"/>

                <!-- Save name display -->
                <TextBlock Text="SAVE NAME" Style="{StaticResource FieldLabel}"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBox x:Name="RunSaveDisplay"
                         Style="{StaticResource DisplayTextBox}"
                         HorizontalAlignment="Center"
                         MinWidth="260"
                         Margin="0,0,0,36"
                         TextAlignment="Center"/>

                <!-- Hint file display -->
                <TextBlock Text="HINT FILE" Style="{StaticResource FieldLabel}"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBox x:Name="RunHintDisplay"
                           Style="{StaticResource DisplayTextBox}"
                           HorizontalAlignment="Center"
                           MinWidth="260"
                           Margin="0,0,0,36"
                           TextAlignment="Center"/>

                <!-- Stop Button -->
                <Button x:Name="StopButton"
                        Style="{StaticResource StopButton}"
                        Content="■  END SESSION"
                        HorizontalAlignment="Center"
                        MinWidth="180"
                        Click="Stop_Click"/>

                <!-- Stop status -->
                <TextBlock x:Name="StopStatusText"
                           Text=""
                           Foreground="#8A7050"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

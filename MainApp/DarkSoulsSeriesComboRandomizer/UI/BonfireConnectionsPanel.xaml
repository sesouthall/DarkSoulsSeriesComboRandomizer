<UserControl x:Class="DarkSoulsSeriesComboRandomizer.BonfireConnectionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1A1A1A">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="28,22,28,12">
            <TextBlock Text="BONFIRE CONNECTIONS"
                       FontFamily="Segoe UI Black" FontSize="15"
                       Foreground="#D4B483" HorizontalAlignment="Center"
                       Margin="0,0,0,4"/>
            <Rectangle Height="1" Fill="#5A4A2A" Margin="0,0,0,10"/>
            <TextBlock Text="Configure which bonfires connect between games when warping."
                       Foreground="#8A7050" FontFamily="Segoe UI" FontSize="11"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Table -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="28,0,28,0">
            <StackPanel>
                <Grid x:Name="BonfireColumnHeaders" Margin="0,0,0,6"/>
                <StackPanel x:Name="BonfireRowsPanel"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                    <Button Style="{StaticResource BrowseButton}"
                            Content="+ Add Row" Padding="10,4" Margin="0,0,8,0"
                            Click="AddBonfireRow_Click"/>
                    <Button Style="{StaticResource BrowseButton}"
                            Content="− Remove Last Row" Padding="10,4"
                            Click="RemoveBonfireRow_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="28,12,28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Style="{StaticResource BrowseButton}"
                    Content="↺  Restore Defaults" Padding="14,6"
                    Click="RestoreBonfireDefaults_Click"/>
            <Button Grid.Column="2"
                    Style="{StaticResource ActionButton}"
                    Content="◀  Back to Settings" Padding="14,6"
                    Click="BackToSettings_Click"/>
        </Grid>
    </Grid>
</UserControl>

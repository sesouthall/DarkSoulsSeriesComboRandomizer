<UserControl x:Class="DarkSoulsSeriesComboRandomizer.SetupPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,22">

            <!-- Title -->
            <TextBlock Text="DARK SOULS SERIES COMBO RANDOMIZER"
                       FontFamily="Segoe UI Black" FontSize="15"
                       Foreground="#D4B483" HorizontalAlignment="Center"
                       Margin="0,0,0,6"/>
            <Rectangle Height="1" Fill="#5A4A2A" Margin="0,0,0,20"/>

            <!-- Game Paths Section -->
            <TextBlock Text="GAME LOCATIONS" Style="{StaticResource SectionHeader}"/>

            <!-- DS1 -->
            <CheckBox x:Name="DS1EnabledCheckBox"
                      Style="{StaticResource GameCheckBox}"
                      Content="Dark Souls Remastered"
                      IsChecked="True" Margin="0,0,0,4"
                      Checked="GameEnabled_Changed" Unchecked="GameEnabled_Changed"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DS1PathBox" Grid.Column="0"
                         Style="{StaticResource DarkTextBox}" Height="30" Margin="0,0,6,0"
                         Text="C:\Program Files (x86)\Steam\steamapps\common\DARK SOULS REMASTERED\DarkSoulsRemastered.exe"
                         TextChanged="GamePath_TextChanged"/>
                <Button x:Name="DS1BrowseButton" Grid.Column="1"
                        Style="{StaticResource BrowseButton}" Height="30"
                        Content="Browse…" Click="BrowseDS1_Click"/>
            </Grid>

            <!-- DS2 -->
            <CheckBox x:Name="DS2EnabledCheckBox"
                      Style="{StaticResource GameCheckBox}"
                      Content="Dark Souls II: Scholar of the First Sin"
                      IsChecked="True" Margin="0,0,0,4"
                      Checked="GameEnabled_Changed" Unchecked="GameEnabled_Changed"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DS2PathBox" Grid.Column="0"
                         Style="{StaticResource DarkTextBox}" Height="30" Margin="0,0,6,0"
                         Text="C:\Program Files (x86)\Steam\steamapps\common\Dark Souls II Scholar of the First Sin\Game\DarkSoulsII.exe"
                         TextChanged="GamePath_TextChanged"/>
                <Button x:Name="DS2BrowseButton" Grid.Column="1"
                        Style="{StaticResource BrowseButton}" Height="30"
                        Content="Browse…" Click="BrowseDS2_Click"/>
            </Grid>

            <!-- DS3 -->
            <CheckBox x:Name="DS3EnabledCheckBox"
                      Style="{StaticResource GameCheckBox}"
                      Content="Dark Souls III"
                      IsChecked="True" Margin="0,0,0,4"
                      Checked="GameEnabled_Changed" Unchecked="GameEnabled_Changed"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DS3PathBox" Grid.Column="0"
                         Style="{StaticResource DarkTextBox}" Height="30" Margin="0,0,6,0"
                         Text="C:\Program Files (x86)\Steam\steamapps\common\DARK SOULS III\Game\DarkSoulsIII.exe"
                         TextChanged="GamePath_TextChanged"/>
                <Button x:Name="DS3BrowseButton" Grid.Column="1"
                        Style="{StaticResource BrowseButton}" Height="30"
                        Content="Browse…" Click="BrowseDS3_Click"/>
            </Grid>

            <Rectangle Height="1" Fill="#3A2E14" Margin="0,0,0,18"/>

            <!-- Randomization Options -->
            <TextBlock Text="RANDOMIZATION OPTIONS" Style="{StaticResource SectionHeader}"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Seed" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="SeedBox" Style="{StaticResource DarkTextBox}"
                             Height="30" TextChanged="Seed_TextChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Save Name" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="SaveNameBox" Style="{StaticResource DarkTextBox}" Height="30"/>
                </StackPanel>
            </Grid>

            <!-- Load Previous Save -->
            <TextBlock Text="Load Previous Save" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="LoadSaveCombo" Style="{StaticResource DarkComboBox}"
                      Height="30" Margin="0,0,0,20"
                      SelectionChanged="LoadSave_SelectionChanged">
                <ComboBoxItem Content="— New Run —" IsSelected="True"/>
            </ComboBox>

            <!-- Game Switch Delay -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Game switch delay (ms)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="GameSwitchDelayBox" Style="{StaticResource DarkTextBox}" Height="30" Text="1500"/>
                </StackPanel>
            </Grid>

            <Rectangle Height="1" Fill="#3A2E14" Margin="0,0,0,16"/>

            <!-- Bonfire Connections Link -->
            <Button x:Name="BonfireConnectionsButton"
                    Style="{StaticResource BrowseButton}"
                    Content="⚙  Customize Bonfire Connections…"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,16"
                    Click="BonfireConnections_Click"/>

            <!-- Status -->
            <TextBlock x:Name="StatusText" Text=""
                       Foreground="#8A7050" FontFamily="Segoe UI" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <!-- Play Button -->
            <Button x:Name="PlayButton"
                    Style="{StaticResource ActionButton}"
                    Content="▶  BEGIN JOURNEY"
                    HorizontalAlignment="Center" MinWidth="180"
                    IsEnabled="False" Click="Play_Click"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
